{
  "expo": {
    "name": "Polar Auth Starter",
    "slug": "polar-auth-starter",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "polarstarter",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.polarauthstarter",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.polarauthstarter",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B12"
      }
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F6F8",
          "dark": {
            "backgroundColor": "#0B0B12"
          }
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {}
    }
  }
}
