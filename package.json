{
  "name": "polar-auth-starter",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@repo/web",
    "dev:api": "turbo run dev --filter=@repo/api",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "deploy": "turbo run deploy",
    "deploy:web": "turbo run deploy --filter=@repo/web",
    "deploy:api": "turbo run deploy --filter=@repo/api",
    "build": "turbo run build",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .gitignore",
    "lint": "oxlint --config oxlint.json",
    "typecheck": "turbo run typecheck",
    "db:studio": "turbo run studio:local --filter=@repo/db"
  },
  "devDependencies": {
    "oxlint": "^0.16.0",
    "prettier": "3",
    "turbo": "^2.5.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
