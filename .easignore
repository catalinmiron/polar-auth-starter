# EAS build upload exclusions (monorepo root — replaces .gitignore for EAS archives).
# Only apps/mobile + the workspace packages it imports are needed on EAS builders.
# Sibling workspaces keep their package.json so `bun install --frozen-lockfile`
# still resolves every workspace in the lockfile.
# Verify what ships: bunx eas-cli build:inspect --platform ios --profile production --stage archive --output <dir>

# ── everything .gitignore excludes ──────────────────────────────────────────
.DS_Store
node_modules/
npm-debug.log
yarn-error.log
.idea
.expo/
dist/
.turbo/
.wrangler/
*.keystore
!debug.keystore

# native build output (regenerated by prebuild on the builder)
ios/build/
android/app/build/
.gradle
DerivedData
xcuserdata
*.ipa
*.xcuserstate

# ── sibling workspaces not needed on the builder ────────────────────────────
apps/web/**
!apps/web/package.json
apps/api/**
!apps/api/package.json
